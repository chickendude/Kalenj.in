# Required: Postgres connection string used by Prisma and the app server.
# Replace the username and password placeholders with your own values.
DATABASE_URL="postgresql://kalenjin_user:your_password@localhost:5432/kalenjin_app?schema=public"

# Optional: Node server port for local preview or VPS runtime.
PORT=3000

# Optional but recommended in production: public origin of the deployed app.
ORIGIN="http://localhost:3000"

# Optional: directory on the server where uploaded entry images are stored.
# Defaults to "./uploads" relative to the project root. Use an absolute path in
# production (e.g. "/var/lib/kalenjin/uploads") to keep media outside the build.
# UPLOADS_DIR="/var/lib/kalenjin/uploads"

# Optional: directory where uploaded audio files are stored.
# Must persist across deploys — do not point inside `build/` or `static/`.
# In production, use a sibling of the app build, e.g. `/var/www/kalenjin/uploads/audio`.
AUDIO_UPLOAD_DIR="./.uploads/audio"

# Required in production: max request body size in bytes for the Node server
# (@sveltejs/adapter-node). Defaults to 512 KB if unset, which is smaller than
# audio uploads — the adapter then rejects them before the app runs, surfacing
# as a generic "Internal Error" and a lost recording session. Keep this in sync
# with the app-level MAX_UPLOAD_BYTES in src/routes/api/audio/*/+server.ts
# (currently 10 MB) so oversized uploads get a clean 413 instead.
BODY_SIZE_LIMIT=10485760
