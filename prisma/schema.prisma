// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  INTERJECTION
  PHRASE
  OTHER
  NAME
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum CourseLessonType {
  VOCABULARY
  STORY
}

enum VocabularyLessonType {
  GRAMMAR
  VOCAB
  EXPRESSION
}

enum UserRole {
  ADMIN
  MANAGER
  USER
}

enum ExampleSentenceStatus {
  NEEDS_PROOFREAD
  IN_CORPUS
  STORY_ONLY
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportTargetType {
  WORD
  SENTENCE
}

enum ReportIssueType {
  WRONG_TRANSLATION
  MISSPELLING
  AUDIO_ISSUE
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id                           String                   @id @default(cuid())
  username                     String                   @unique
  email                        String?                  @unique
  emailVerifiedAt              DateTime?
  displayName                  String?
  passwordHash                 String
  role                         UserRole
  themePreference              String                   @default("auto")
  statsFilterPreference        String?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  sessions                     Session[]
  emailVerificationTokens      EmailVerificationToken[]
  recordedWordAudio            Word[]                   @relation("WordAudioRecorder")
  recordedWordPluralAudio      Word[]                   @relation("WordPluralAudioRecorder")
  recordedWordIncertainAudio   Word[]                   @relation("WordIncertainAudioRecorder")
  recordedSentenceAudio        ExampleSentence[]        @relation("ExampleSentenceAudioRecorder")
  submittedWordSuggestions     WordSuggestion[]         @relation("WordSuggestionSubmitter")
  reviewedWordSuggestions      WordSuggestion[]         @relation("WordSuggestionReviewer")
  submittedSentenceSuggestions SentenceSuggestion[]     @relation("SentenceSuggestionSubmitter")
  reviewedSentenceSuggestions  SentenceSuggestion[]     @relation("SentenceSuggestionReviewer")
  reportsSubmitted             Report[]                 @relation("ReportReporter")
  reportsResolved              Report[]                 @relation("ReportResolver")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Word {
  id                      String                        @id @default(cuid())
  kalenjin                String
  slug                    String                        @unique
  translations            String
  kalenjinNormalized      String
  partOfSpeech            PartOfSpeech?
  notes                   String?
  pluralForm              String?
  pluralFormNormalized    String?
  incertainForm           String?
  incertainFormNormalized String?
  isPluralOnly            Boolean                       @default(false)
  isSingularOnly          Boolean                       @default(false)
  isSwahiliLoan           Boolean                       @default(false)
  presentAnee             String?
  presentInyee            String?
  presentInee             String?
  presentEchek            String?
  presentOkwek            String?
  presentIchek            String?
  imageUrl                String?
  audioUrl                String?
  audioRecordedById       String?
  audioRecordedAt         DateTime?
  audioRecordedBy         User?                         @relation("WordAudioRecorder", fields: [audioRecordedById], references: [id], onDelete: SetNull)
  pluralAudioUrl          String?
  pluralAudioRecordedById String?
  pluralAudioRecordedAt   DateTime?
  pluralAudioRecordedBy   User?                         @relation("WordPluralAudioRecorder", fields: [pluralAudioRecordedById], references: [id], onDelete: SetNull)
  incertainAudioUrl          String?
  incertainAudioRecordedById String?
  incertainAudioRecordedAt   DateTime?
  incertainAudioRecordedBy   User?                      @relation("WordIncertainAudioRecorder", fields: [incertainAudioRecordedById], references: [id], onDelete: SetNull)
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  sentences               WordSentence[]
  tokenLinks              ExampleSentenceToken[]
  tokenSegments           ExampleSentenceTokenSegment[]
  lessonWords             LessonWord[]
  spellings               WordSpelling[]
  wordOfDayEntries        WordOfTheDay[]
  relatedWords            RelatedWord[]                 @relation("RelatedWordSource")
  relatedToWords          RelatedWord[]                 @relation("RelatedWordTarget")
  observedForms           ObservedWordForm[]
  suggestionsApproved     WordSuggestion[]              @relation("WordSuggestionApprovedWord")
  reports                 Report[]

  @@index([kalenjin])
  @@index([kalenjinNormalized])
  @@index([pluralFormNormalized])
  @@index([incertainFormNormalized])
  @@index([translations])
  @@index([kalenjinNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "Word_kalenjinNormalized_trgm_idx")
  @@index([pluralFormNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "Word_pluralFormNormalized_trgm_idx")
  @@index([incertainFormNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "Word_incertainFormNormalized_trgm_idx")
  @@index([translations(ops: raw("gin_trgm_ops"))], type: Gin, map: "Word_translations_trgm_idx")
}

model WordOfTheDay {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  wordId    String
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wordId])
  @@index([date])
}

model WordSpelling {
  id                 String   @id @default(cuid())
  wordId             String
  spelling           String
  spellingNormalized String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  word               Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([wordId, spellingNormalized])
  @@index([spellingNormalized])
  @@index([spellingNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "WordSpelling_spellingNormalized_trgm_idx")
}

model RelatedWord {
  id            String   @id @default(cuid())
  wordId        String
  relatedWordId String
  createdAt     DateTime @default(now())
  word          Word     @relation("RelatedWordSource", fields: [wordId], references: [id], onDelete: Cascade)
  relatedWord   Word     @relation("RelatedWordTarget", fields: [relatedWordId], references: [id], onDelete: Cascade)

  @@unique([wordId, relatedWordId])
  @@index([relatedWordId])
}

// Derived search table for prior surface-form -> lemma links. User-facing edit paths
// maintain it incrementally; run `npm run backfill:observed-forms` after migrations,
// imports, or background sync jobs to reconcile drift from bulk token rewrites.
model ObservedWordForm {
  normalizedForm String
  wordId         String
  usageCount     Int      @default(1)
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  word           Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([normalizedForm, wordId])
  @@index([wordId])
  @@index([normalizedForm(ops: raw("gin_trgm_ops"))], type: Gin, map: "ObservedWordForm_normalizedForm_trgm_idx")
}

// Surface forms (e.g. proper nouns like names) that should not be flagged as
// missing a lemma. The cleanup page treats any token whose normalizedForm
// matches an entry here as resolved.
model IgnoredWordForm {
  normalizedForm String   @id
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ExampleSentence {
  id                  String                 @id @default(cuid())
  kalenjin            String
  english             String
  notes               String?
  isUnique            Boolean                @default(false)
  status              ExampleSentenceStatus  @default(NEEDS_PROOFREAD)
  lemmaProofreadAt    DateTime?
  imageUrl            String?
  audioUrl            String?
  audioRecordedById   String?
  audioRecordedAt     DateTime?
  audioRecordedBy     User?                  @relation("ExampleSentenceAudioRecorder", fields: [audioRecordedById], references: [id], onDelete: SetNull)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  words               WordSentence[]
  tokens              ExampleSentenceToken[]
  lessonWords         LessonWord[]
  storySentence       StorySentence?
  suggestionsApproved SentenceSuggestion[]   @relation("SentenceSuggestionApprovedSentence")
  reports             Report[]

  @@index([kalenjin])
  @@index([status])
  @@index([kalenjin(ops: raw("gin_trgm_ops"))], type: Gin, map: "ExampleSentence_kalenjin_trgm_idx")
  @@index([english(ops: raw("gin_trgm_ops"))], type: Gin, map: "ExampleSentence_english_trgm_idx")
}

model ExampleSentenceToken {
  id                   String                        @id @default(cuid())
  exampleSentenceId    String
  wordId               String?
  inContextTranslation String?
  tokenOrder           Int
  surfaceForm          String
  normalizedForm       String
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  exampleSentence      ExampleSentence               @relation(fields: [exampleSentenceId], references: [id], onDelete: Cascade)
  word                 Word?                         @relation(fields: [wordId], references: [id], onDelete: SetNull)
  segments             ExampleSentenceTokenSegment[]

  @@unique([exampleSentenceId, tokenOrder])
  @@index([exampleSentenceId])
  @@index([wordId])
  @@index([normalizedForm])
}

model ExampleSentenceTokenSegment {
  id             String               @id @default(cuid())
  tokenId        String
  wordId         String?
  segmentOrder   Int
  segmentStart   Int
  segmentEnd     Int
  surfaceForm    String
  normalizedForm String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  token          ExampleSentenceToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  word           Word?                @relation(fields: [wordId], references: [id], onDelete: SetNull)

  @@unique([tokenId, segmentOrder])
  @@index([tokenId])
  @@index([wordId])
  @@index([normalizedForm])
}

model WordSentence {
  wordId            String
  exampleSentenceId String
  word              Word            @relation(fields: [wordId], references: [id], onDelete: Cascade)
  exampleSentence   ExampleSentence @relation(fields: [exampleSentenceId], references: [id], onDelete: Cascade)

  @@id([wordId, exampleSentenceId])
  @@index([exampleSentenceId])
}

model Story {
  id          String          @id @default(cuid())
  title       String
  description String?
  source      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  sentences   StorySentence[]
  lesson      Lesson?
}

model StorySentence {
  id                String          @id @default(cuid())
  storyId           String
  exampleSentenceId String          @unique
  sentenceOrder     Int
  speaker           String?
  grammarNotes      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  story             Story           @relation(fields: [storyId], references: [id], onDelete: Cascade)
  exampleSentence   ExampleSentence @relation(fields: [exampleSentenceId], references: [id], onDelete: Restrict)

  @@unique([storyId, sentenceOrder])
  @@index([storyId])
  @@index([exampleSentenceId])
}

model CefrEnglishTarget {
  id                    String      @id @default(cuid())
  level                 CefrLevel
  english               String      @unique
  notes                 String?
  coveredByLessonWordId String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  coveredByLessonWord   LessonWord? @relation(fields: [coveredByLessonWordId], references: [id], onDelete: SetNull)

  @@index([level])
  @@index([coveredByLessonWordId])
}

model Lesson {
  id              String                @id @default(cuid())
  level           CefrLevel
  title           String
  lessonOrder     Int
  type            CourseLessonType
  vocabularyType  VocabularyLessonType?
  grammarMarkdown String?
  notes           String?
  status          PublishStatus         @default(DRAFT)
  storyId         String?               @unique
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  sections        LessonSection[]
  story           Story?                @relation(fields: [storyId], references: [id], onDelete: SetNull)

  @@unique([level, lessonOrder])
  @@index([level])
  @@index([type])
}

model LessonSection {
  id           String       @id @default(cuid())
  lessonId     String
  title        String?
  sectionOrder Int
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  words        LessonWord[]

  @@unique([lessonId, sectionOrder])
  @@index([lessonId])
}

model LessonWord {
  id                     String              @id @default(cuid())
  lessonSectionId        String
  wordId                 String?
  kalenjin               String
  translations           String
  itemOrder              Int
  sentenceId             String?             @unique
  sentenceTranslation    String?
  wordForWordTranslation String?
  notesMarkdown          String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  lessonSection          LessonSection       @relation(fields: [lessonSectionId], references: [id], onDelete: Cascade)
  word                   Word?               @relation(fields: [wordId], references: [id], onDelete: SetNull)
  sentence               ExampleSentence?    @relation(fields: [sentenceId], references: [id], onDelete: Restrict)
  coveredCefrTargets     CefrEnglishTarget[]

  @@unique([lessonSectionId, itemOrder])
  @@unique([lessonSectionId, wordId])
  @@index([lessonSectionId])
  @@index([wordId])
}

model WordSuggestion {
  id                     String           @id @default(cuid())
  kalenjin               String
  translations           String
  partOfSpeech           PartOfSpeech?
  notes                  String?
  alternativeSpellings   String?
  pluralForm             String?
  incertainForm          String?
  isPluralOnly           Boolean          @default(false)
  isSingularOnly         Boolean          @default(false)
  alternativePluralForms String?
  presentAnee            String?
  presentInyee           String?
  presentInee            String?
  presentEchek           String?
  presentOkwek           String?
  presentIchek           String?
  status                 SuggestionStatus @default(PENDING)
  submitterId            String
  submitter              User             @relation("WordSuggestionSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)
  reviewerId             String?
  reviewer               User?            @relation("WordSuggestionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote             String?
  reviewedAt             DateTime?
  approvedWordId         String?
  approvedWord           Word?            @relation("WordSuggestionApprovedWord", fields: [approvedWordId], references: [id], onDelete: SetNull)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([status])
  @@index([submitterId])
  @@index([createdAt])
}

model SentenceSuggestion {
  id                 String           @id @default(cuid())
  kalenjin           String
  english            String
  notes              String?
  status             SuggestionStatus @default(PENDING)
  submitterId        String
  submitter          User             @relation("SentenceSuggestionSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)
  reviewerId         String?
  reviewer           User?            @relation("SentenceSuggestionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote         String?
  reviewedAt         DateTime?
  approvedSentenceId String?
  approvedSentence   ExampleSentence? @relation("SentenceSuggestionApprovedSentence", fields: [approvedSentenceId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status])
  @@index([submitterId])
  @@index([createdAt])
}

model Report {
  id           String           @id @default(cuid())
  targetType   ReportTargetType
  wordId       String?
  word         Word?            @relation(fields: [wordId], references: [id], onDelete: Cascade)
  sentenceId   String?
  sentence     ExampleSentence? @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  issueType    ReportIssueType
  suggestedFix String?
  reporterId   String?
  reporter     User?            @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  status       ReportStatus     @default(OPEN)
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?            @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([wordId])
  @@index([sentenceId])
}
